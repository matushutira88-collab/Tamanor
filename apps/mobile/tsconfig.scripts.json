{
  // Node-side typecheck for the test scripts under `scripts/`. They run under `tsx`,
  // not Metro, so they need Node's globals and libs — which must NOT leak into the
  // app's own tsconfig, where `process`/`Buffer` are not generally available.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".expo"]
}
